# Le variabili che IN-Motion si aspetta. Copia questo file in .env e
# riempilo: .env non finisce mai su git, questo sì.
#
#   cp .env.esempio .env
#
# Il server le legge UNA VOLTA all'avvio: dopo averle cambiate, riavvialo.

# Le frasi della meditazione. Senza, entrano quelle di riserva scritte a mano
# e l'esperienza va avanti lo stesso.
ANTHROPIC_API_KEY=

# La guida che legge le scritte ad alta voce. Senza, l'opera resta muta — ed e'
# un ripiego legittimo, ma attenzione: e' la durata delle clip a decidere
# quanto ogni scritta resta a schermo, quindi senza voce l'esperienza scorre
# molto piu' in fretta.
ELEVENLABS_API_KEY=

# Firebase: account, profilo e storico delle sessioni. Solo versione web.
# I valori stanno nella console Firebase del progetto:
#   Impostazioni progetto -> Le tue app -> Configurazione SDK
# Finche' FIREBASE_API_KEY e' vuota, app.js salta il login e avvia
# l'esperienza direttamente: e' il ripiego previsto, non un guasto.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
